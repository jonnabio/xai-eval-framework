# Python standard
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
.venv/
.venv-exp3/
venv/
env/
.env

# Secrets (local API keys — never commit)
configs/secrets/*
!configs/secrets/.gitkeep
*.local.env

# MS Office owner lock files
~$*

# Jupyter Notebooks
.ipynb_checkpoints

# OS specific
.DS_Store

# Testing and Linters
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov/

# IDEs
.vscode
.idea

# Local Data (exclude datasets but keep config/experiments)
/data/
/datasets/

# Models
*.joblib
*.pkl

# Outputs and Logs
logs/
# outputs/* not outputs/: git cannot re-include a file whose parent
# directory is excluded, so the negations below were silently inert and
# three cited artifacts never entered the repository.
outputs/*
!outputs/batch_results.csv
!outputs/batch_manifest.json
!outputs/analysis/
!outputs/analysis/paper_a_exp2_stats/
!outputs/analysis/paper_a_exp2_stats/**
experiments/**/results/
!experiments/exp1_adult/reproducibility/**/results.json
!experiments/exp1_adult/results/tuning/**/results.json
!experiments/exp2_comparative/results/
!experiments/exp2_scaled/results/
!experiments/exp3_cross_dataset/results/
!experiments/recovery/**/results/
!experiments/recovery/**/results.json

# LaTeX build artifacts
*.aux
*.log
*.out

# Portable TeX compiler (large binary, downloaded on demand)
tools/tectonic-portable/

/.quarto/
**/*.quarto_ipynb

# Corpus PDFs are reproducible from corpus_pdfs/RETRIEVAL_LOG.md (source URL per paper).
# Not tracked: ~139MB, and 17 are duplicates of files already in thesis/papers/.
docs/reports/paper_bc/corpus_pdfs/*.pdf
