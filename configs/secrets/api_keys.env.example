# Template for configs/secrets/api_keys.env (committed; holds no keys). Copy it to
# api_keys.env in the same folder and fill in the keys there -- that file is gitignored.
# Loaded automatically by src/llm/client.py (LLMClientFactory) from this file in
# this checkout, and shared with every git worktree of the repository
# (e.g. ../xai-exp4, ../xai-paper-bc). Variables already set in the environment win.
#
# Put the key after the = with no quotes and no spaces. Leave unused lines empty.

# OpenRouter: EXP4 cohort 2 judges (gpt-5.4-mini, claude-haiku-4.5, gemini-3.8-flash)
OPENROUTER_API_KEY=

# Direct provider keys (only for provider: openai / gemini in a config)
OPENAI_API_KEY=
GOOGLE_API_KEY=
