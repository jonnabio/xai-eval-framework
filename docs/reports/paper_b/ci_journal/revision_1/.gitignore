# Every generated file of the revision is tracked, the build's intermediate files
# (build/_latex/: LaTeX run, the rebuilt baseline and the letter source) included
# (author request, 2026-11-06). Only temporary files are left out.
build/**/*.tmp
build/**/~$*
# env/ is caught by a repository-wide "env/" rule; re-include it here.
!env/
!env/**
